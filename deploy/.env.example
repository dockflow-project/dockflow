# Copy to deploy/.env and provide local-only development credentials before up.
# Keep the copied deploy/.env private; never commit live credentials.
COMPOSE_PROJECT_NAME=dockflow-reference
DOCKFLOW_IMAGE=dockflow-pipelines:development
DOCKFLOW_PORT=8080
DOCKFLOW_CONFIG=./dockflow.toml
DOCKFLOW_DEFINITIONS=./definitions
DOCKFLOW_INPUTS=./inputs
MINIO_ROOT_USER=replace-with-local-access-key
MINIO_ROOT_PASSWORD=replace-with-random-local-secret
MINIO_BUCKET=dockflow
